{{- if .isWorkLaptop -}}
{
  "apiKeyHelper": "ztoken token -n zllm",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "3600000",
    "ANTHROPIC_BASE_URL": "{{ onepasswordRead "op://work/dotfiles/ANTHROPIC_BASE_URL" }}",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "ANTHROPIC_MODEL": "bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "bedrock/anthropic.claude-3-haiku-20240307-v1:0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "bedrock/anthropic.claude-sonnet-4-20250514-v1:0"
  },
  "alwaysThinkingEnabled": true,
  "autoUpdates": 1
}
{{ end }}